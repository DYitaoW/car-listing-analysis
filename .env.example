# API
API_HOST=127.0.0.1
API_PORT=43124
DATABASE_URL=sqlite+aiosqlite:///./data/listings.db
REDIS_URL=redis://127.0.0.1:6379/0
# inprocess = no Redis required (default for local scaffold)
JOB_BACKEND=inprocess

# Supabase Storage + Auth (preferred). Leave blank for local disk + anonymous checks.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Project Settings → API → JWT Secret (used by the FastAPI server to verify access tokens)
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=listing-images
# When Supabase Auth is configured, listing APIs require a signed-in user (default true)
AUTH_REQUIRED=true

# Web client (same project URL + anon key). Required for Sign in / Google on the site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local image stub when Supabase is unset
LOCAL_UPLOAD_DIR=./data/uploads

# LLM provider: gemini | ollama | stub
# stub still inspects the photos (resolution, duplicates, placeholders) plus NHTSA.
# gemini and ollama also compare the photos with the seller's description.
LLM_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b

# The web app calls the same-origin proxy /api/lv. The Next server forwards to this URL.
# Do not point the browser at 127.0.0.1 directly — Firefox reports that as
# "NetworkError when attempting to fetch resource" when the page is opened from another host.
API_PROXY_URL=http://127.0.0.1:43124
# Set this only when the browser should call a public API origin directly.
# NEXT_PUBLIC_API_URL=
# On a phone, 127.0.0.1 is the phone. Use the computer's LAN address, or edit API server in the app.
EXPO_PUBLIC_API_URL=http://127.0.0.1:43124
