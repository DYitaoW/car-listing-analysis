# API
API_HOST=127.0.0.1
API_PORT=43124
DATABASE_URL=sqlite+aiosqlite:///./data/listings.db
REDIS_URL=redis://127.0.0.1:6379/0
# inprocess = no Redis required (default for local scaffold)
JOB_BACKEND=inprocess

# Supabase Storage (preferred). Leave blank to store images on local disk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=listing-images

# Local image stub when Supabase is unset
LOCAL_UPLOAD_DIR=./data/uploads

# LLM provider: gemini | ollama | stub
LLM_PROVIDER=stub
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Clients
NEXT_PUBLIC_API_URL=http://127.0.0.1:43124
EXPO_PUBLIC_API_URL=http://127.0.0.1:43124
