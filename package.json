{
  "name": "listing-validator",
  "private": true,
  "scripts": {
    "install:app": "node scripts/install-app.mjs",
    "start": "node scripts/start-app.mjs",
    "dev": "pnpm run --parallel dev:web dev:api",
    "dev:web": "pnpm --filter web exec next dev --port 43123 --hostname 127.0.0.1",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:api": "node scripts/run-api.mjs",
    "setup:api": "node scripts/run-api.mjs setup",
    "setup:web": "pnpm install",
    "build:web": "pnpm --filter web build",
    "lint:web": "pnpm --filter web lint"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  }
}
